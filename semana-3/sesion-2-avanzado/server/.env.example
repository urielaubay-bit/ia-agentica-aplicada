# Copia a .env y ajusta. NUNCA subas .env al repo.
DATABASE_URL=postgresql://neuron:neuron@localhost:5432/neuronbank
PORT=8000
# Scoping por rol (opcional): vacío = analista (ve todo); con valor = cajero forzado.
# CUENTA=CU-1001

# Integración de correo (tool enviar_reporte_por_correo).
# Por defecto apunta a Mailpit (buzón de prueba en Docker, sin credenciales):
#   SMTP_HOST=mailpit   SMTP_PORT=1025
# Para correo real, apunta a tu proveedor (ej Gmail con app password):
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=tu@gmail.com
# SMTP_PASS=app_password
# SMTP_FROM=reportes@neuronbank.mx
