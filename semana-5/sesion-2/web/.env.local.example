# Copia este archivo a .env.local y llena tus llaves.
#   cp .env.local.example .env.local
# .env.local esta en .gitignore: tus llaves nunca se suben.

# --- Obligatorio ---
ANTHROPIC_API_KEY=sk-ant-...

# --- Modelos (opcional: estos son los valores por omision) ---
# El router manda las consultas faciles al modelo barato.
MODELO_RAZONA=claude-sonnet-5-5
MODELO_VOLUMEN=claude-haiku-5-5
# ROUTER=off   # descomenta para apagar el router y mandar todo al modelo caro

# --- Observabilidad (opcional) ---
# Langfuse: crea un proyecto en langfuse.com y copia sus llaves.
# OJO: la variable es LANGFUSE_BASEURL, sin guion bajo entre BASE y URL.
# La region de la URL tiene que ser la misma de tus llaves (us o eu),
# si no, el exporter manda las trazas al vacio y no avisa.
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_BASEURL=https://us.cloud.langfuse.com
# LANGFUSE_DEBUG=true   # imprime cada lote que sale hacia Langfuse

# LangSmith: alternativa a Langfuse. Si pones estas, el lab usa LangSmith.
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=lsv2_...
# LANGSMITH_PROJECT=neuronbank
